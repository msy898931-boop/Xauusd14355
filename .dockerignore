# Keep the build context small and the image free of anything the daemon does
# not need. The package is stdlib-only, so this is mostly about not shipping
# state, tests, and editor noise into a container.
.git
.github
.gitignore
**/__pycache__
**/*.pyc
**/*.egg-info
marketdesk/tests
marketdesk/data
marketdesk/README.md
marketdesk/AGENTS.md
biquote
longdata
.agent_tmp
.openhands
*.md
Dockerfile
.dockerignore
